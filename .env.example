# FastAPI Configuration
PORT=8000
HOST=127.0.0.1

# Database Configuration
# For development, we use SQLite
DATABASE_URL=sqlite:///./secure_vault.db

# Security Settings
# Generate secure keys using python: secrets.token_hex(32)
JWT_SECRET_KEY=your_super_secret_jwt_key_here_at_least_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server Master Key for OTP File Key Encryption (MUST be 32 bytes in Hex: 64 hex chars)
SERVER_MASTER_KEY=your_32_byte_hex_server_master_key_here_64_chars

# Storage configuration
UPLOAD_DIR=./uploads

# OTP Service configuration
# Options: console, twilio, fast2sms
OTP_PROVIDER=console

# Twilio Credentials (required if OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Fast2SMS Credentials (required if OTP_PROVIDER=fast2sms)
FAST2SMS_API_KEY=

# Gmail SMTP Email Credentials (required if OTP_PROVIDER=email or if recipient is an email)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password

